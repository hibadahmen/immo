@import "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap";

/* src/styles.css */
:root {
  --purple: #5946c6;
  --purple-dark: #403095;
  --lavender: #f0edfa;
  --ink: #242334;
  --muted: #696779;
  --line: #e8e5f0;
  --background: #fff;
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  margin: 0;
  padding: 48px 32px;
  background:
    radial-gradient(
      ellipse at 4% 8%,
      #7a5ade 0%,
      transparent 48%),
    linear-gradient(
      135deg,
      #4f3895,
      #161b42 78%);
  background-attachment: fixed;
  color: var(--ink);
  font:
    15px/1.7 "DM Sans",
    Arial,
    sans-serif;
}
a {
  color: inherit;
  text-decoration: none;
}
a:hover {
  color: var(--purple);
}
button,
input,
select,
textarea {
  font: inherit;
}
button {
  cursor: pointer;
}
button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}
:focus-visible {
  outline: 3px solid #9e8ef0;
  outline-offset: 4px;
}
h1,
h2,
h3,
.brand {
  font-family:
    Manrope,
    Arial,
    sans-serif;
  line-height: 1.25;
  letter-spacing: -.035em;
}
h1 {
  font-size: clamp(30px, 4vw, 48px);
  margin: 12px 0 18px;
  font-weight: 800;
}
h2 {
  font-size: clamp(25px, 3vw, 36px);
  margin: 8px 0 18px;
}
h3 {
  font-size: 18px;
  margin: 12px 0;
}
p {
  margin: 0 0 16px;
}
small {
  color: var(--muted);
  font-size: 12px;
}
img {
  max-width: 100%;
}
main {
  min-height: 65vh;
  min-width: 0;
}
.site-frame {
  max-width: 1400px;
  margin: auto;
  background: white;
  border-radius: 26px;
  box-shadow: 0 32px 90px #09082740;
  position: relative;
}
.container {
  max-width: 1216px;
  margin: auto;
  width: calc(100% - 112px);
}
.section {
  padding: 48px 0;
}
.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  margin-bottom: 30px;
}
.subtitle,
.section-description {
  color: var(--muted);
}
.section-description {
  font-size: 14px;
}
.eyebrow {
  color: var(--purple);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .17em;
  margin-bottom: 18px;
}
.text-link {
  color: var(--purple);
  font-weight: 600;
}
.center-action {
  text-align: center;
  margin-top: 36px;
}
.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--purple);
  border-radius: 8px;
  background: var(--purple);
  color: white;
  padding: 13px 22px;
  font-weight: 600;
  line-height: 1.4;
  transition: background .2s, transform .2s;
}
.button:hover {
  background: var(--purple-dark);
  color: white;
  transform: translateY(-2px);
}
.button.secondary {
  background: white;
  color: var(--purple);
  border-color: #d8d0ed;
}
.button.secondary:hover {
  background: var(--lavender);
}
.button.small {
  padding: 9px 14px;
  font-size: 12px;
}
.button.full {
  width: 100%;
  margin: 12px 0;
}
.navbar {
  padding: 28px 56px;
  display: flex;
  align-items: center;
  gap: 45px;
}
.brand {
  font-weight: 800;
  font-size: 29px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
}
.brand-icon {
  color: var(--purple);
  font-size: 36px;
  line-height: 1;
}
.brand-dot {
  color: var(--purple);
  margin-left: -7px;
}
.navbar nav {
  display: flex;
  align-items: center;
  gap: 28px;
  flex: 1;
  font-size: 13px;
  font-weight: 500;
}
.nav-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 25px;
}
.active {
  color: var(--purple);
}
.menu-toggle {
  display: none;
  background: var(--lavender);
  color: var(--purple);
  border: 0;
  padding: 10px 14px;
  border-radius: 8px;
}
.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #e4ddf8;
  color: var(--purple);
  font-weight: 700;
  font-size: 20px;
}
.small-avatar {
  width: 30px;
  height: 30px;
  font-size: 13px;
}
.profile-menu {
  position: relative;
}
.profile-menu summary {
  display: flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  list-style: none;
}
.profile-menu summary::-webkit-details-marker {
  display: none;
}
.profile-dropdown {
  position: absolute;
  right: 0;
  top: calc(100% + 16px);
  z-index: 10;
  min-width: 235px;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px;
  background: white;
  box-shadow: 0 14px 35px #201b4e20;
}
.profile-dropdown a,
.profile-dropdown button {
  display: block;
  text-align: left;
  width: 100%;
  padding: 10px;
  border: 0;
  border-radius: 6px;
  background: white;
  font-size: 13px;
  color: var(--ink);
}
.profile-dropdown a:hover,
.profile-dropdown button:hover {
  background: var(--lavender);
  color: var(--purple);
}
.skip-link {
  position: absolute;
  top: 5px;
  left: -10000px;
  padding: 10px;
  background: white;
  z-index: 20;
}
.skip-link:focus {
  left: 20px;
}
.loading-bar {
  padding: 8px 25px;
  background: var(--lavender);
  text-align: center;
  color: var(--purple);
  font-size: 12px;
}
.hero {
  position: relative;
  min-height: 520px;
  margin: 0 28px;
  border-radius: 16px;
  background: #222339;
  isolation: isolate;
  padding: 68px 60px 90px;
  color: white;
}
.hero-background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: inherit;
  z-index: -2;
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      #121529bf,
      #14162544);
  border-radius: inherit;
  z-index: -1;
}
.hero-copy {
  max-width: 760px;
}
.hero h1 {
  font-size: clamp(38px, 4.8vw, 62px);
  line-height: 1.14;
  margin: 15px 0 25px;
  letter-spacing: -.045em;
}
.hero .eyebrow {
  color: #e1dcff;
}
.hero-description {
  color: #efedf5;
  font-size: 16px;
  max-width: 550px;
}
.hero-caption {
  position: absolute;
  bottom: 27px;
  left: 60px;
  color: #e2dfea;
  font-size: 9px;
  letter-spacing: .16em;
}
.hero-search {
  margin-top: 32px;
}
label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  margin: 16px 0;
  color: #51495e;
}
input,
select,
textarea {
  display: block;
  width: 100%;
  border: 1px solid #ddd7e6;
  border-radius: 8px;
  padding: 11px 13px;
  margin-top: 7px;
  background: #fdfcfe;
  color: var(--ink);
  min-width: 0;
}
input:focus,
select:focus,
textarea:focus {
  border-color: var(--purple);
  outline: 2px solid #5946c620;
}
textarea {
  resize: vertical;
}
.search-bar {
  background: white;
  border-radius: 12px;
  padding: 14px;
  display: flex;
  gap: 12px;
  align-items: center;
  box-shadow: 0 10px 35px #16102e20;
  color: var(--ink);
}
.search-bar label {
  flex: 1;
  padding: 0 14px;
  margin: 0;
  border-right: 1px solid var(--line);
  min-width: 0;
}
.search-bar label span {
  font-size: 11px;
  color: #51495e;
}
.search-bar input,
.search-bar select {
  border: 0;
  background: white;
  padding: 6px 0;
  margin: 0;
  font-size: 12px;
}
.search-bar button {
  flex-shrink: 0;
}
.filters {
  display: flex;
  align-items: flex-end;
  gap: 14px;
  padding: 22px;
  background: #faf9fd;
  border: 1px solid var(--line);
  border-radius: 14px;
  flex-wrap: wrap;
  margin: 30px 0;
}
.filters label {
  flex: 1;
  min-width: 140px;
  margin: 0;
}
.filters input,
.filters select {
  margin: 6px 0 0;
  background: white;
}
.filter-error {
  flex-basis: 100%;
  margin: 0 !important;
}
.search-bar:has(.filter-error) {
  flex-wrap: wrap;
}
.result-count {
  font-size: 13px;
  color: var(--muted);
}
.categories-section {
  padding: 32px 0 15px;
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.category-card {
  position: relative;
  height: 145px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--lavender);
  transition: transform .2s;
}
.category-card:hover {
  transform: translateY(-3px);
}
.category-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.category-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent, #151125a6);
}
.category-card > span {
  position: absolute;
  bottom: 15px;
  left: 18px;
  right: 18px;
  display: flex;
  justify-content: space-between;
  color: white;
  z-index: 1;
  font-size: 15px;
  font-weight: 600;
}
.introduction {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.introduction h2 {
  font-size: clamp(28px, 3.1vw, 40px);
}
.platform-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 13px;
  margin: 24px 0 10px;
}
.platform-stats > div {
  background: var(--lavender);
  border-radius: 10px;
  padding: 14px 20px;
}
.platform-stats strong {
  display: block;
  font-family:
    Manrope,
    Arial,
    sans-serif;
  color: var(--purple);
  font-size: 28px;
  line-height: 1.3;
}
.platform-stats span {
  font-size: 11px;
  color: #645e77;
}
.photo-collage {
  position: relative;
  min-height: 405px;
  padding: 0 0 45px 25px;
}
.collage-main {
  width: 86%;
  height: 335px;
  object-fit: cover;
  border-radius: 16px;
}
.collage-small {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 50%;
  height: 210px;
  object-fit: cover;
  border-radius: 14px;
  border: 7px solid white;
}
.collage-label {
  position: absolute;
  bottom: 10px;
  left: 0;
  padding: 19px 22px;
  background: var(--purple);
  color: white;
  border-radius: 10px;
  display: flex;
  gap: 15px;
  align-items: center;
}
.collage-label > span {
  font-size: 30px;
}
.collage-label strong {
  font-size: 13px;
  line-height: 1.5;
}
#comment-ca-marche {
  scroll-margin-top: 25px;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}
.service-card {
  padding: 26px 23px;
  background: var(--lavender);
  border-radius: 12px;
  position: relative;
  transition: transform .2s;
}
.service-card:hover {
  transform: translateY(-4px);
}
.service-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: white;
  color: var(--purple);
  font-size: 26px;
}
.step-number {
  position: absolute;
  top: 30px;
  right: 23px;
  color: #8e81b3;
  font-size: 12px;
}
.service-card h3 {
  margin-top: 23px;
  font-size: 17px;
}
.service-card p {
  font-size: 12px;
  color: var(--muted);
  min-height: 62px;
}
.service-link {
  color: var(--purple);
  font-size: 11px;
  font-weight: 700;
}
.service-card.featured {
  background: var(--purple);
  color: white;
}
.service-card.featured:hover {
  color: white;
  background: var(--purple-dark);
}
.featured .service-icon {
  background: #ffffff20;
  color: white;
}
.featured p,
.featured .service-link,
.featured .step-number {
  color: #eeeaff;
}
.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}
.property-card {
  height: 100%;
  transition: transform .2s;
}
.property-card:hover {
  transform: translateY(-3px);
}
.card-image {
  height: 260px;
  position: relative;
  overflow: hidden;
  border-radius: 14px;
  background: var(--lavender);
}
.card-image > a {
  display: block;
  height: 100%;
}
.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .4s;
}
.property-card:hover .card-image img {
  transform: scale(1.035);
}
.tag {
  position: absolute;
  top: 16px;
  left: 16px;
  border-radius: 6px;
  background: #fffffff0;
  font-size: 10px;
  padding: 5px 10px;
  font-weight: 600;
}
.heart {
  position: absolute;
  top: 14px;
  right: 14px;
  background: white;
  border: 0;
  border-radius: 50%;
  width: 35px;
  height: 35px;
  font-size: 24px;
  line-height: 1;
  color: var(--ink);
}
.heart.selected {
  color: var(--purple);
}
.card-content {
  position: relative;
  margin: -38px 12px 0;
  padding: 21px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 11px;
  box-shadow: 0 8px 22px #35245b08;
}
.location {
  color: var(--muted);
  font-size: 11px;
  margin: 0 0 8px;
}
.card-content h3 {
  font-size: 15px;
  min-height: 38px;
  margin: 0 0 12px;
  overflow-wrap: anywhere;
}
.features {
  color: var(--muted);
  font-size: 11px;
  display: flex;
  gap: 12px;
}
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding-top: 14px;
  gap: 8px;
  flex-wrap: wrap;
}
.card-bottom p {
  margin: 0;
}
.card-bottom strong {
  font-size: 16px;
  color: var(--purple);
}
.card-bottom span {
  font-size: 10px;
  color: var(--muted);
}
.card-bottom a {
  font-size: 11px;
  color: var(--purple);
  font-weight: 600;
}
.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 30px;
  box-shadow: 0 8px 25px #35245b05;
}
.empty {
  grid-column: 1/-1;
  text-align: center;
  background: var(--lavender);
  border-radius: 16px;
  padding: 55px 25px;
  margin: 20px 0;
}
.empty h2 {
  font-size: 24px;
}
.empty p {
  color: var(--muted);
}
.error,
.success,
.notice {
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 13px;
  margin: 16px 0;
}
.error {
  background: #fff0ef;
  color: #9b2828;
}
.success {
  background: #eaf7ed;
  color: #256739;
}
.notice {
  background: var(--lavender);
  color: #62546f;
}
.auth-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 65px;
  align-items: start;
}
.auth-intro {
  padding-top: 25px;
}
.auth-intro p {
  color: var(--muted);
}
.auth-intro img {
  width: 100%;
  height: 350px;
  object-fit: cover;
  border-radius: 16px;
  margin-top: 20px;
}
.auth-intro h1 {
  font-size: 40px;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 20px;
}
.demo-box {
  background: #f6f3fa;
  border-radius: 10px;
  padding: 18px;
  font-size: 12px;
  margin-top: 22px;
}
.demo-box p {
  margin: 6px 0 12px;
}
.demo-box small {
  display: block;
  margin-top: 12px;
  overflow-wrap: anywhere;
}
.demo-box .button {
  margin-bottom: 5px;
}
.narrow {
  max-width: 820px;
}
.detail-eyebrow {
  margin-top: 25px;
}
.gallery {
  display: flex;
  gap: 20px;
  overflow: auto;
  margin: 30px 0;
}
.gallery img {
  width: 100%;
  max-height: 450px;
  object-fit: cover;
  border-radius: 16px;
  min-width: 0;
  flex: 1;
}
.gallery img + img {
  max-width: 35%;
}
.detail-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 50px;
}
.detail-facts {
  display: flex;
  gap: 16px;
  margin-bottom: 30px;
}
.detail-facts span,
.chips span {
  background: var(--lavender);
  padding: 9px 16px;
  border-radius: 8px;
  font-size: 13px;
  color: #67577e;
}
.detail-grid h2 {
  font-size: 24px;
  margin: 24px 0 16px;
}
.description {
  white-space: pre-line;
  overflow-wrap: anywhere;
  color: var(--muted);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.detail-grid aside {
  align-self: start;
}
.price {
  font-size: 30px;
  color: var(--purple);
}
fieldset {
  min-width: 0;
  padding: 0;
  margin: 22px 0;
  border: 0;
}
legend {
  width: 100%;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
  font-weight: 700;
  font-size: 16px;
}
.photo-preview {
  height: 210px;
  width: 100%;
  object-fit: cover;
  border-radius: 10px;
  margin: 15px 0;
  background: var(--lavender);
}
.app-layout.with-sidebar {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  border-top: 1px solid var(--line);
}
.with-sidebar main {
  background: #faf9fd;
}
.with-sidebar .container {
  width: calc(100% - 60px);
}
.sidebar {
  height: 100%;
  background: #f4f1fb;
  padding: 30px 16px;
}
.sidebar-person {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
  gap: 6px;
  margin-bottom: 28px;
}
.sidebar-person strong {
  font-size: 13px;
  margin-top: 6px;
}
.sidebar-person small {
  text-transform: capitalize;
}
.sidebar nav {
  display: grid;
  gap: 8px;
}
.sidebar nav a {
  font-size: 12px;
  padding: 12px;
  border-radius: 8px;
}
.sidebar nav a.active {
  background: var(--purple);
  color: white;
}
.sidebar nav a:hover:not(.active) {
  background: #e9e2f8;
}
.sidebar-note {
  border-top: 1px solid #e1d9ef;
  margin-top: 36px;
  padding: 20px 8px;
  color: var(--muted);
  font-size: 11px;
}
.with-sidebar .auth-layout {
  grid-template-columns: 1fr;
}
.with-sidebar .auth-intro {
  display: none;
}
.with-sidebar .cards {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.tabs {
  display: flex;
  gap: 30px;
  margin: 20px 0 30px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--line);
}
.tabs a {
  font-weight: 600;
  font-size: 14px;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 35px;
}
.stats > div {
  background: white;
  border: 1px solid var(--line);
  padding: 23px;
  border-radius: 12px;
}
.stats span {
  color: var(--muted);
  font-size: 12px;
}
.stats strong {
  display: block;
  color: var(--purple);
  font-family:
    Manrope,
    Arial,
    sans-serif;
  font-size: 36px;
}
.actions {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.badge {
  display: inline-block;
  padding: 4px 10px;
  background: #fff2d8;
  color: #825509;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}
.badge.active-badge,
.badge.accepted {
  background: #e9f6ed;
  color: #27653c;
}
.badge.refused {
  background: #ffebed;
  color: #a12b3a;
}
.badge.cancelled {
  background: #edf0f6;
  color: #4c5a72;
}
.badge.muted {
  background: #f0eef2;
  color: #696473;
}
.table-scroll {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: white;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  text-align: left;
}
caption {
  text-align: left;
  font-weight: 700;
  font-size: 16px;
  padding: 20px;
}
th {
  background: #f4f1fa;
  color: #645b78;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .05em;
}
td,
th {
  padding: 16px 18px;
  border-bottom: 1px solid var(--line);
  vertical-align: middle;
}
tbody tr:last-child td {
  border-bottom: 0;
}
tbody tr:hover {
  background: #fbfaff;
}
td h3 {
  font-size: 13px;
  margin: 0 0 5px;
  min-width: 140px;
}
td p {
  font-size: 11px;
  margin: 0;
  color: var(--muted);
}
.table-property {
  display: flex;
  align-items: center;
  gap: 13px;
}
.table-property img {
  width: 62px;
  height: 62px;
  object-fit: cover;
  border-radius: 8px;
}
.table-message {
  display: block;
  max-width: 260px;
  margin-top: 7px;
  font-size: 11px;
  color: var(--muted);
  white-space: pre-line;
  overflow-wrap: anywhere;
}
.date-cell {
  min-width: 115px;
}
footer {
  border-top: 1px solid var(--line);
  padding: 40px 56px;
  display: flex;
  justify-content: space-between;
  gap: 35px;
  background: #f8f7fc;
  border-radius: 0 0 26px 26px;
}
footer .brand {
  font-size: 25px;
}
footer p {
  font-size: 12px;
  color: var(--muted);
  margin: 14px 0 0;
}
footer nav {
  display: flex;
  flex-direction: column;
  gap: 9px;
  font-size: 12px;
}
.footer-note {
  font-size: 11px;
  color: var(--muted);
  align-self: flex-end;
}
@media (max-width: 1150px) {
  body {
    padding: 28px 20px;
  }
  .navbar {
    padding: 24px 32px;
    gap: 25px;
  }
  .navbar nav {
    gap: 18px;
  }
  .nav-actions {
    gap: 15px;
  }
  .navbar .button {
    padding: 12px 14px;
    font-size: 12px;
  }
  .container {
    width: calc(100% - 64px);
  }
  .hero {
    padding: 55px 35px 75px;
  }
  .hero-caption {
    left: 35px;
  }
  .introduction {
    gap: 35px;
  }
  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .app-layout.with-sidebar {
    grid-template-columns: 185px minmax(0, 1fr);
  }
  .with-sidebar .container {
    width: calc(100% - 40px);
  }
  .stats {
    gap: 12px;
  }
  .stats > div {
    padding: 18px;
  }
}
@media (max-width: 900px) {
  .navbar {
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .menu-toggle {
    display: block;
  }
  .navbar nav {
    display: none;
    width: 100%;
    flex: auto;
    flex-direction: column;
    align-items: stretch;
    gap: 5px;
  }
  .navbar nav.open {
    display: flex;
  }
  .navbar nav > a {
    padding: 10px;
  }
  .nav-actions {
    margin: 8px 0 0;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .profile-dropdown {
    right: auto;
    left: 0;
  }
  .search-bar {
    flex-wrap: wrap;
  }
  .search-bar label {
    min-width: 130px;
  }
  .hero {
    min-height: 550px;
  }
  .introduction {
    grid-template-columns: 1fr;
  }
  .photo-collage {
    max-width: 550px;
    width: 100%;
    margin: auto;
  }
  .auth-layout {
    gap: 30px;
  }
  .auth-intro h1 {
    font-size: 32px;
  }
  .detail-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .category-grid {
    gap: 14px;
  }
  .category-card {
    height: 120px;
  }
  .category-card > span {
    font-size: 12px;
    left: 12px;
    right: 12px;
  }
  .app-layout.with-sidebar {
    display: block;
  }
  .sidebar {
    padding: 15px 20px;
  }
  .sidebar-person,
  .sidebar-note {
    display: none;
  }
  .sidebar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .sidebar nav a {
    padding: 9px 12px;
  }
}
@media (max-width: 600px) {
  body {
    padding: 12px 8px;
  }
  .site-frame {
    border-radius: 18px;
  }
  .navbar {
    padding: 20px;
    gap: 15px;
  }
  .brand {
    font-size: 25px;
  }
  .container,
  .with-sidebar .container {
    width: calc(100% - 36px);
  }
  .section {
    padding: 32px 0;
  }
  .hero {
    margin: 0 12px;
    padding: 38px 20px 68px;
    min-height: 570px;
    border-radius: 12px;
  }
  .hero h1 {
    font-size: 37px;
  }
  .hero-description {
    font-size: 14px;
  }
  .desktop-break {
    display: none;
  }
  .hero .eyebrow {
    font-size: 9px;
  }
  .hero-caption {
    left: 20px;
    right: 20px;
    font-size: 8px;
  }
  .hero-search {
    margin-top: 24px;
  }
  .search-bar {
    gap: 8px;
    padding: 12px;
  }
  .search-bar label {
    padding: 5px 8px;
    flex-basis: 100%;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .search-bar .button {
    width: 100%;
  }
  .categories-section {
    padding-top: 20px;
  }
  .category-grid {
    grid-template-columns: 1fr 1fr;
  }
  .category-card {
    height: 130px;
  }
  .section-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
  .section-description br {
    display: none;
  }
  .introduction {
    gap: 30px;
  }
  .photo-collage {
    min-height: 330px;
    padding-left: 10px;
  }
  .collage-main {
    height: 270px;
  }
  .collage-small {
    height: 175px;
  }
  .collage-label {
    padding: 14px;
  }
  .service-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .service-card {
    padding: 24px;
  }
  .service-card p {
    min-height: 0;
  }
  .cards,
  .with-sidebar .cards {
    grid-template-columns: 1fr;
  }
  .card-image {
    height: 250px;
  }
  .card-content h3 {
    min-height: 0;
  }
  .auth-layout {
    grid-template-columns: 1fr;
  }
  .auth-intro {
    padding-top: 0;
  }
  .auth-intro img {
    display: none;
  }
  .panel {
    padding: 22px;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .filters {
    padding: 16px;
    gap: 12px;
  }
  .filters label {
    min-width: calc(50% - 12px);
  }
  .filters .button {
    flex: 1;
    font-size: 12px;
  }
  .gallery {
    gap: 10px;
    scroll-snap-type: x mandatory;
  }
  .gallery img,
  .gallery img + img {
    min-width: 100%;
    max-width: 100%;
    height: 300px;
    scroll-snap-align: start;
  }
  .detail-facts {
    gap: 8px;
    flex-wrap: wrap;
  }
  .stats {
    gap: 8px;
  }
  .stats > div {
    padding: 12px;
  }
  .stats span {
    font-size: 10px;
  }
  .stats strong {
    font-size: 28px;
  }
  .tabs {
    gap: 18px;
  }
  .tabs a {
    font-size: 12px;
  }
  td,
  th {
    padding: 12px;
  }
  footer {
    padding: 30px 22px;
    flex-direction: column;
    gap: 22px;
    border-radius: 0 0 18px 18px;
  }
  .footer-note {
    align-self: flex-start;
  }
}
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  * {
    transition: none !important;
  }
}

